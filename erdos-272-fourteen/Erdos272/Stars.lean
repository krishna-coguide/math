private def fits (bit : Mask) (cs : List Bucket) : Bool :=
  decide (cs.length ≤ 95) && cs.all Bucket.sound &&
  ((supers 14 bit.toNat &&& paletteTable cs) == supers 14 bit.toNat)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
private theorem palette_ok (i : Fin 14) : fits ((1 : Mask) <<< i.val) (palette i) = true := by
  fin_cases i <;> decide +kernel

private theorem singleton_sub (a : Mask) (x : Fin 14) (hx : a.getLsbD x = true) :
    sub ((1 : Mask) <<< x.val) a = true := by
  simp only [sub, beq_iff_eq]
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  simp only [BitVec.getLsbD_and]
  by_cases he : j = x.val
  · subst j; simp [hx]
  · have hz : (((1 : Mask) <<< x.val).getLsbD j) = false := by
      simp [hj]; omega
    rw [hz]; rfl

theorem star_bound (F : Finset Mask)
    (hg : ∀ a ∈ F, ∀ b ∈ F, a ≠ b → ap (a &&& b) = true)
    (x : Fin 14) (hx : ∀ a ∈ F, a.getLsbD x = true) : F.card ≤ 95 := by
  have h := palette_ok x
  simp only [fits, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  exact (bound_through F _ (palette x) hg (fun a ha => singleton_sub a x (hx a ha)) h.1.2 h.2).trans h.1.1

